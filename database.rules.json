{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "$roomId.matches(/^[0-9]{3}$/) && (newData.child('roomType').val() !== 'limited' || (newData.child('hostVer').isNumber() && newData.child('hostVer').val() >= 2 && (!newData.child('guestId').exists() || (newData.child('guestVer').isNumber() && newData.child('guestVer').val() >= 2))) && (newData.child('limitedMode').val() !== 'fire' || (newData.child('hostVer').val() >= 3 && (!newData.child('guestId').exists() || newData.child('guestVer').val() >= 3))))"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": true,
      "$name": {
        ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "leaderboard": {
      ".read": true,
      "$board": {
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['displayName', 'score'])"
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        "$conn": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && (data.val() === true || (data.child('lastActive').isNumber() && data.child('lastActive').val() < now - 86400000))))"
        }
      }
    },
    "cards": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matchmaking": {
      "$type": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "bots": {
      ".read": true,
      "$botId": {
        ".write": "auth != null"
      }
    },
    "botLease": {
      ".read": "auth != null",
      "$botId": {
        ".write": "auth != null"
      }
    },
    "liveIndex": {
      ".read": true,
      "$code": {
        ".write": "auth != null"
      }
    },
    "spectate": {
      "$code": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "replays": {
      ".read": true,
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['seed', 'moves'])"
      }
    },
    "userReplays": {
      "$uid": {
        ".read": true,
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['seed', 'moves'])"
        }
      }
    },
    "lobbyChat": {
      ".read": true,
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ts', 'kind', 'name'])"
      }
    },
    "lobbyActive": {
      ".read": true,
      "$conn": {
        ".write": "auth != null"
      }
    },
    "lobbyHost": {
      ".read": true,
      ".write": "auth != null"
    },
    "lobbyExhibition": {
      ".read": true,
      ".write": "auth != null"
    },
    "lobbySeen": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    }
  }
}
