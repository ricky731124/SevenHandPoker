# Firebase web config for the Realtime Database connection.
# Copy this file to `.env` and fill in your own project's values (see
# docs/FIREBASE_SETUP.md). These are safe to expose in the client bundle —
# Firebase web config is public by design; security is enforced by DB rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
